{% if site.posts != empty %}
  {% if site.latest_posts.limit %}
    {% assign latest_posts_limit = site.latest_posts.limit %}
  {% else %}
    {% assign latest_posts_limit = site.posts | size %}
  {% endif %}
  <ul class="home-posts">
    {% for item in site.posts limit: latest_posts_limit %}
      {% if item.redirect == blank %}
        {% assign item_url = item.url | relative_url %}
      {% elsif item.redirect contains '://' %}
        {% assign item_url = item.redirect %}
      {% else %}
        {% assign item_url = item.redirect | relative_url %}
      {% endif %}
      <li>
        <span class="home-post-date">{{ item.date | date: '%b %d, %Y' }}</span>
        <a class="home-post-title" href="{{ item_url }}">{{ item.title }}</a>
      </li>
    {% endfor %}
  </ul>
  <div class="home-posts-links">
    <a href="{{ '/blog/' | relative_url }}">All posts →</a>
    <a href="{{ '/writing/' | relative_url }}">On the Memgraph blog →</a>
  </div>
{% else %}
  <p>No posts so far...</p>
{% endif %}
